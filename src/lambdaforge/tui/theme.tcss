Screen {
    background: $surface;
    color: $text;
}

#console-body {
    height: 1fr;
}

#sidebar {
    width: 22;
    min-width: 18;
    background: $panel;
    border-right: solid $primary-background;
    padding: 1 1;
}

#brand {
    text-style: bold;
    color: $primary;
    margin: 0 0 1 1;
}

.sidebar-section-label {
    height: 1;
    margin: 1 1 0 1;
    color: $text-muted;
    text-style: bold;
}

#sidebar-navigation {
    height: auto;
    padding: 0 0 0 1;
    border-left: solid $primary-background;
}

.nav-button {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0;
    text-align: left;
}

.sidebar-action {
    margin: 0 0 1 0;
    border: round $primary;
    text-style: bold;
}

.sidebar-action:focus {
    border: round $accent;
    text-style: bold;
}

.sidebar-spacer {
    height: 1fr;
}

#nav-exit {
    dock: bottom;
    color: $error;
    background: $panel;
    border: round $error;
}

#nav-exit:focus {
    color: $error;
    background: $panel;
    border: round $error;
    text-style: bold;
}

#content {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

.screen-title, .modal-title {
    text-style: bold;
    color: $primary;
    height: auto;
    margin-bottom: 1;
}

.status-line {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

.freshness-line {
    height: 1;
    color: $text-muted;
    text-style: dim;
    margin-top: 1;
    text-align: right;
}

#screen-table {
    height: 1fr;
    border: round $primary-background;
}

#overview-grid {
    grid-size: 3 1;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: 1fr;
    grid-gutter: 1 1;
    height: 12;
}

.overview-card {
    height: 100%;
    border: round $primary-background;
    background: $panel;
}

.overview-section-title {
    height: 1;
    padding: 0 1;
    text-style: bold;
    color: $accent;
}

.overview-card DataTable {
    height: 1fr;
}

#overview-detail-scroll {
    height: 1fr;
    margin-top: 1;
    padding: 1;
    border: round $primary-background;
    background: $panel;
}

#overview-detail {
    height: auto;
}

#overview-resource-dashboard {
    height: 17;
    margin-top: 1;
}

.resource-summary {
    height: auto;
    min-height: 2;
    padding: 0 1;
    color: $text;
}

.resource-summary-row {
    height: auto;
    min-height: 4;
}

.resource-summary-row .resource-summary {
    width: 1fr;
}

.resource-export {
    width: 10;
    min-width: 10;
    height: 3;
    margin: 0 1;
}

.resource-plot-grid {
    grid-size: 3 1;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: 1fr;
    grid-gutter: 1;
    height: 1fr;
}

.resource-plot-card {
    height: 100%;
    min-width: 24;
    background: $panel;
    border: round $primary-background;
}

.resource-plot-title {
    height: 1;
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

.resource-plot {
    height: 1fr;
    min-height: 10;
}

.resource-plot-fallback {
    min-height: 3;
    border: round $primary-background;
    padding: 1;
}

.curve-page-summary {
    height: auto;
    min-height: 2;
    padding: 0 1;
    color: $text-muted;
}

.curve-controls {
    height: 4;
    padding: 0 1;
    align-vertical: middle;
}

.curve-page-button {
    width: auto;
    min-width: 12;
    height: 3;
    min-height: 3;
    margin-right: 1;
}

#curve-page-select {
    width: 24;
    margin-right: 1;
}

#seed-metric-dashboard {
    height: 34;
    min-height: 26;
}

.metric-plot-grid {
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 1fr 1fr;
    grid-gutter: 1 1;
    height: 1fr;
}

.metric-plot-card {
    height: 100%;
    min-width: 28;
    background: $panel;
    border: round $primary-background;
}

.metric-plot-title {
    height: 1;
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

.metric-plot {
    height: 1fr;
    min-height: 11;
}

.metric-plot-fallback {
    height: auto;
    min-height: 20;
    padding: 1;
}

#overview-controls {
    height: 1;
}

.detail-panel, .help-panel {
    height: auto;
    min-height: 3;
    padding: 1;
    margin-top: 1;
    background: $panel;
    border-left: thick $primary;
}

ContextHelp, ExplanationDialog, ClusterEditor, WorkLaunchDialog, YamlFilePicker, ExactConfirmation, CredentialDialog {
    align: center middle;
    background: rgba(0, 0, 0, 0.65);
}

.modal-card {
    width: 64;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

.wide-modal {
    width: 78;
}

#work-launch-dialog, #yaml-picker-dialog {
    width: 92;
    height: 90%;
}

#cluster-editor {
    width: 92%;
    min-width: 68;
    max-width: 112;
    height: 92%;
}

#cluster-editor-tabs {
    height: 1fr;
    min-height: 18;
}

.cluster-editor-page {
    height: 1fr;
    padding: 0 1 1 1;
    scrollbar-color: $primary;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
}

.cluster-editor-page .field-label {
    height: 1;
    margin-top: 1;
    color: $text-muted;
}

#cluster-advanced {
    height: 1fr;
    min-height: 12;
    margin-top: 1;
    border: round $primary-background;
}

#cluster-help {
    min-height: 3;
    max-height: 5;
    margin-top: 0;
}

#cluster-editor-error {
    height: auto;
    min-height: 1;
    color: $error;
}

#launch-recent-table {
    height: 8;
    min-height: 5;
    margin-top: 1;
    border: round $primary-background;
}

#launch-recent-help {
    min-height: 2;
}

#launch-config-row, #launch-target-row, #yaml-picker-location-row {
    height: 3;
    min-height: 3;
    margin-top: 1;
    align-vertical: middle;
}

#launch-config, #yaml-picker-location {
    width: 1fr;
}

#launch-browse, #yaml-picker-open {
    width: auto;
    min-width: 18;
    margin-left: 1;
}

#launch-cluster-label {
    width: 10;
    height: 1;
    padding-left: 1;
}

#launch-cluster {
    width: 1fr;
}

#launch-status, #yaml-picker-error {
    height: auto;
    min-height: 1;
    color: $text-muted;
}

#work-launch-body {
    height: 1fr;
    min-height: 8;
    padding: 0 1;
    scrollbar-color: $primary;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
}

#launch-preview-content {
    height: auto;
    min-height: 5;
    margin-top: 1;
    padding: 1;
    border: round $primary-background;
}

#launch-preview-content.validation-error {
    color: $text;
    border: round $error;
    background: $error-muted;
}

#yaml-picker-tree {
    height: 1fr;
    min-height: 12;
    margin-top: 1;
    border: round $primary-background;
    scrollbar-color: $primary;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
}

#detail-dialog {
    height: 85%;
}

#detail-scroll {
    height: 1fr;
    padding: 0 1;
    border: round $primary-background;
    scrollbar-color: $primary;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
}

#detail-content {
    width: 100%;
    height: auto;
}

.modal-actions {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

.modal-actions Button {
    margin-left: 1;
}

.section-title {
    text-style: bold;
    color: $accent;
}

.muted {
    color: $text-muted;
    height: auto;
    margin-top: 1;
}

Screen.narrow #sidebar {
    width: 16;
    min-width: 14;
}

Screen.narrow #content {
    padding: 0 1;
}

Screen.narrow #overview-grid {
    grid-size: 1 3;
    grid-columns: 1fr;
    grid-rows: 8 8 8;
    height: 24;
}

Screen.narrow .modal-card, Screen.narrow .wide-modal {
    width: 90%;
}

ResearchWorkspace {
    layout: vertical;
    background: $surface;
}

.workspace-navigation {
    height: 3;
    background: $panel;
    border-bottom: solid $primary-background;
}

.workspace-back {
    width: auto;
    min-width: 14;
    height: 3;
    min-height: 3;
    padding: 0 1;
    color: $accent;
    background: $panel;
    border: none;
}

.workspace-back:focus {
    color: $text;
    background: $primary-background;
    text-style: bold;
}

.breadcrumb-trail {
    width: 1fr;
    height: 3;
    padding: 0 1;
    background: $panel;
    align-vertical: middle;
    overflow-x: auto;
}

.breadcrumb-button {
    width: auto;
    min-width: 1;
    height: 3;
    min-height: 3;
    padding: 0 1;
    border: none;
    background: $panel;
    color: $accent;
}

.breadcrumb-button:hover, .breadcrumb-button:focus {
    background: $primary-background;
    text-style: underline;
}

.breadcrumb-current, .breadcrumb-current:disabled {
    color: $text;
    opacity: 100%;
    text-style: bold;
}

.breadcrumb-separator {
    width: 1;
    height: 3;
    padding-top: 1;
    color: $text-muted;
}

.workspace-loading {
    height: 1fr;
    align: center middle;
    color: $text-muted;
}

.workspace-loading LoadingIndicator {
    width: 18;
    height: 4;
}

.workspace-loading Label {
    width: auto;
    height: auto;
    max-width: 80;
    text-align: center;
}

.inline-loading {
    height: 8;
    align: center middle;
    color: $text-muted;
}

.inline-loading LoadingIndicator {
    width: 14;
    height: 3;
}

.workspace-header {
    height: auto;
    min-height: 3;
    padding: 1 2;
    text-style: bold;
    color: $text;
    border-bottom: solid $primary-background;
}

.workspace-panel {
    height: auto;
    padding: 1 2;
}

.workspace-actions {
    height: 4;
    padding: 0 2;
    margin: 1 0;
    overflow-x: auto;
}

.workspace-actions Button {
    width: auto;
    min-width: 10;
    height: 3;
    min-height: 3;
    margin: 0 1 0 0;
    padding: 0 1;
    border: round $primary-background;
}

.workspace-actions Button:focus {
    border: round $accent;
    text-style: bold;
}

.compact-actions {
    height: 3;
    margin: 0 2;
    padding: 0;
    align-horizontal: right;
}

.compact-actions Button {
    height: 3;
    min-height: 3;
    min-width: 10;
}

#study-control-bar {
    width: 100%;
    height: 3;
    padding: 0 2;
    overflow: hidden hidden;
}

#study-control-bar > Button {
    width: auto;
    min-width: 14;
    height: 3;
    min-height: 3;
    margin: 0;
    padding: 0 1;
    border: round $primary-background;
}

#study-control-bar > Button:focus {
    border: round $accent;
    text-style: bold;
}

#study-action-status {
    width: 1fr;
    height: 3;
    margin: 0;
    padding: 1 0 0 1;
    text-align: right;
}

.legend {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

ResearchWorkspace TabbedContent {
    height: 1fr;
}

ResearchWorkspace DataTable {
    height: 1fr;
    border: round $primary-background;
}

#cluster-workspace-main {
    height: 1fr;
    min-height: 8;
    overflow-y: auto;
    scrollbar-color: $primary;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
}

#cluster-detail-tabs {
    height: 29;
    min-height: 18;
}

#cluster-operation-log {
    height: 14;
    min-height: 6;
    margin: 0 2;
    padding: 0 1;
    border: round $primary-background;
    background: $panel;
}

#cluster-operation-toolbar {
    height: 3;
    margin: 0 2;
    align-vertical: middle;
}

#cluster-operation-toolbar .section-title {
    width: auto;
    min-width: 20;
    height: 1;
    margin-right: 1;
}

#cluster-operation-status {
    width: 1fr;
    height: 1;
    color: $text-muted;
}

#cluster-operation-size {
    width: 20;
    height: 3;
    margin-right: 1;
}

#cluster-operation-clear {
    width: 9;
    min-width: 9;
    height: 3;
}

#cluster-operation-resize {
    height: 1;
    margin: 0 2;
    text-align: center;
    color: $text-muted;
    background: $primary-background;
}

#cluster-operation-resize:hover {
    color: $text;
    background: $accent;
}

#confirmation-scroll {
    height: 1fr;
    min-height: 12;
    margin: 1 0;
    padding: 0 1;
    border: round $primary-background;
    scrollbar-color: $primary;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
}

#exact-preview {
    height: auto;
    padding: 1;
}

.cluster-overview-grid, .dataset-summary-grid {
    grid-size: 4 1;
    grid-columns: 1fr 1fr 1fr 1fr;
    grid-rows: 6;
    grid-gutter: 1;
    height: 7;
    margin: 1 2;
}

.study-overview-grid, .hpo-summary-grid, .hpo-parameter-summary-grid {
    grid-size: 4 1;
    grid-columns: 1fr 1fr 1fr 1fr;
    grid-rows: 6;
    grid-gutter: 1;
    height: 7;
    margin: 1 2;
}

#study-overview-dashboard, #hpo-parameter-dashboard {
    height: 22;
    margin: 0 2 1 2;
}

.study-plot-grid, .hpo-plot-grid {
    grid-size: 2 1;
    grid-columns: 1fr 1fr;
    grid-rows: 1fr;
    grid-gutter: 1;
    height: 1fr;
}

.study-plot-card, .hpo-plot-card {
    height: 100%;
    min-width: 30;
    background: $panel;
    border: round $primary-background;
}

.study-plot-title, .hpo-plot-title {
    height: 1;
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

.study-plot, .hpo-plot {
    height: 1fr;
    min-height: 12;
}

.study-state-counts {
    height: 2;
    padding: 0 1;
    color: $text-muted;
    text-align: center;
}

.study-plot-fallback, .hpo-plot-fallback {
    height: auto;
    min-height: 5;
    padding: 1;
    border: round $primary-background;
}

#study-best-parameters {
    height: 9;
    margin: 0 2 1 2;
}

#hpo-parameter-table, #hpo-action-table {
    min-height: 12;
}

#hpo-action-preview {
    min-height: 5;
    max-height: 8;
}

#hpo-dispersion-table, #hpo-relation-table {
    height: 10;
    margin: 0 2 1 2;
}

#analysis-interaction-table {
    height: 12;
}

#analysis-interaction-matrix {
    height: 14;
    margin: 0 1;
}

#analysis-coverage-dashboard {
    height: 1fr;
    padding: 1 2;
}

.analysis-seed-grid {
    grid-size: 3 1;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: 7;
    grid-gutter: 1;
    height: 8;
    margin: 1 2 0 2;
}

#analysis-seed-content {
    min-height: 5;
    margin: 1 2;
}

#analysis-scientific-pareto {
    height: 10;
    margin: 0 2;
}

#analysis-resource-pareto {
    height: 1fr;
    min-height: 12;
    margin: 0 2;
}

#analysis-pareto-content {
    height: 3;
    margin: 0 2;
}

#analysis-finding-table {
    height: 1fr;
    min-height: 12;
}

#analysis-finding-content {
    min-height: 7;
    max-height: 11;
}

.coverage-summary-grid {
    grid-size: 3 1;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: 6;
    grid-gutter: 1;
    height: 7;
}

.coverage-plot {
    height: 16;
    min-height: 12;
    border: round $primary-background;
    background: $panel;
}

#coverage-table {
    height: 1fr;
    min-height: 10;
    margin-top: 1;
}

HpoParameterWorkspace .section-title {
    margin: 1 2 0 2;
}

.metric-card {
    height: 100%;
    padding: 1;
    background: $panel;
    border: round $primary-background;
    color: $text;
}

#cluster-live-dashboard {
    height: 18;
    margin: 0 2 1 2;
}

#cluster-screen-dashboard {
    height: 17;
    margin-top: 1;
}

.dataset-split-title {
    height: 1;
    margin: 1 2 0 2;
}

#dataset-toolbar {
    height: 4;
    align-vertical: middle;
    overflow-x: hidden;
}

#dataset-operation-status {
    width: 1fr;
    height: auto;
    padding: 1 1 0 0;
    color: $text-muted;
}

#dataset-operation-status.operation-error {
    color: $error;
}

#dataset-delete {
    width: auto;
    min-width: 24;
}

#dataset-split-table {
    height: 9;
    margin: 0 2;
    border: round $primary-background;
}

.dataset-action-state {
    height: 1fr;
    align: center middle;
    padding: 2;
}

.dataset-action-state Static {
    width: 70;
    max-width: 90%;
    height: auto;
    margin-bottom: 1;
    text-align: center;
    color: $text-muted;
}

.dataset-action-state Button {
    width: auto;
    min-width: 24;
}

.danger-action-state {
    border: round $error;
    margin: 2;
}

#dataset-stat-content, #dataset-integrity-content {
    height: 1fr;
    padding: 1 2;
}

Screen.narrow .resource-plot-grid {
    grid-size: 1 3;
    grid-columns: 1fr;
    grid-rows: 13 13 13;
    height: 39;
}

Screen.narrow .metric-plot-grid {
    grid-size: 1 4;
    grid-columns: 1fr;
    grid-rows: 14 14 14 14;
    height: 56;
}

Screen.narrow #seed-metric-dashboard {
    height: 58;
}

Screen.narrow #overview-resource-dashboard,
Screen.narrow #cluster-screen-dashboard,
Screen.narrow #cluster-live-dashboard {
    height: 42;
}

Screen.narrow .cluster-overview-grid,
Screen.narrow .dataset-summary-grid,
Screen.narrow .study-overview-grid,
Screen.narrow .hpo-summary-grid,
Screen.narrow .hpo-parameter-summary-grid {
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 6 6;
    height: 13;
}

Screen.narrow .study-plot-grid, Screen.narrow .hpo-plot-grid {
    grid-size: 1 2;
    grid-columns: 1fr;
    grid-rows: 14 14;
    height: 28;
}

Screen.narrow #study-overview-dashboard,
Screen.narrow #hpo-parameter-dashboard {
    height: 30;
}
