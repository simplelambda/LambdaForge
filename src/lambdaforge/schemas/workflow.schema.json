{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplelambda.dev/lambdaforge/schemas/workflow-1.0.json",
  "title": "LambdaForge workflow",
  "description": "A dependency graph of complete task or training experiment documents.",
  "type": "object",
  "required": ["kind", "schema_version", "name", "nodes"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "workflow"},
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1},
    "output_root": {"type": "string", "minLength": 1},
    "max_parallel": {"type": "integer", "minimum": 1},
    "resources": {"$ref": "#/$defs/resources"},
    "metadata": {"type": "object"},
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["config"],
        "additionalProperties": false,
        "properties": {
          "config": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object"}]},
          "needs": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}]},
          "bindings": {"type": "object"},
          "resources": {"type": "object"},
          "on": {"type": "string", "minLength": 1, "default": "local"},
          "continue_on_failure": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {"type": "integer", "minimum": 1},
        "cpus": {"type": "integer", "minimum": 1},
        "cpu_cores": {"type": "integer", "minimum": 1},
        "ram": {"type": ["integer", "string"]},
        "memory": {"type": ["integer", "string"]},
        "ram_bytes": {"type": ["integer", "string"]},
        "gpu": {"type": "integer", "minimum": 0},
        "gpus": {"type": "integer", "minimum": 0},
        "gpu_count": {"type": "integer", "minimum": 0},
        "gpu_memory": {"type": ["integer", "string"]},
        "gpu_memory_bytes": {"type": ["integer", "string"]},
        "time": {"type": ["number", "string"]},
        "runtime_seconds": {"type": ["number", "string", "null"]},
        "storage": {"type": ["integer", "string"]},
        "storage_bytes": {"type": ["integer", "string"]},
        "processes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
