{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplelambda.github.io/lambdaforge/schemas/work.schema.json",
  "title": "LambdaForge Work",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "run": {"type": "string", "pattern": "^[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)+$"},
    "with": {"type": "object"},
    "resources": {"$ref": "#/$defs/resources"},
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer"}
    },
    "search": {"type": "object", "minProperties": 1},
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "mode"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "mode": {"enum": ["min", "max"]}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/run"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["parallel"],
            "properties": {
              "parallel": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/run"}
              }
            }
          }
        ]
      }
    }
  },
  "oneOf": [
    {"required": ["run"], "not": {"required": ["steps"]}},
    {"required": ["steps"], "not": {"required": ["run"]}}
  ],
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "run": {"type": "string", "minLength": 3},
        "with": {"type": "object"},
        "resources": {"$ref": "#/$defs/resources"},
        "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
        "search": {"type": "object", "minProperties": 1},
        "objective": {"type": "object"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {"type": "integer", "minimum": 1},
        "memory": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string"}]},
        "gpu": {"type": "integer", "minimum": 0},
        "gpu_memory": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string"}]},
        "time": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "string"}]},
        "storage": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string"}]},
        "processes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
