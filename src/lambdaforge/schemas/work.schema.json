{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplelambda.github.io/lambdaforge/schemas/work.schema.json",
  "title": "LambdaForge Work",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "run": {"type": "string", "pattern": "^[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)+$"},
    "with": {"type": "object"},
    "resources": {"$ref": "#/$defs/resources"},
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer"}
    },
    "replicates": {"type": "integer", "minimum": 1},
    "search": {"$ref": "#/$defs/search"},
    "sweep": {"$ref": "#/$defs/sweep"},
    "execution": {"$ref": "#/$defs/execution"},
    "objective": {"$ref": "#/$defs/objective"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/run"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["parallel"],
            "properties": {
              "parallel": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/run"}
              }
            }
          }
        ]
      }
    }
  },
  "oneOf": [
    {"required": ["run"], "not": {"required": ["steps"]}},
    {"required": ["steps"], "not": {"required": ["run"]}}
  ],
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "run": {"type": "string", "minLength": 3},
        "with": {"type": "object"},
        "resources": {"$ref": "#/$defs/resources"},
        "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
        "replicates": {"type": "integer", "minimum": 1},
        "search": {"$ref": "#/$defs/search"},
        "sweep": {"$ref": "#/$defs/sweep"},
        "execution": {"$ref": "#/$defs/execution"},
        "objective": {"$ref": "#/$defs/objective"}
      }
    },
    "objective": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
        "metric": {"type": "string", "minLength": 1},
        "mode": {"enum": ["min", "max"]},
        "range": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "minItems": 2,
          "maxItems": 2
        },
        "aggregation": {"enum": ["weighted_mean", "geometric", "chebyshev"]},
        "practical_margin": {"type": "number", "minimum": 0},
        "metrics": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["weight"],
            "properties": {
              "mode": {"enum": ["min", "max"]},
              "weight": {"type": "number", "minimum": 0},
              "range": {
                "oneOf": [
                  {"type": "number", "exclusiveMinimum": 0},
                  {
                    "type": "array",
                    "prefixItems": [{"type": "number"}, {"type": "number"}],
                    "minItems": 2,
                    "maxItems": 2
                  }
                ]
              }
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "anyOf": [{"required": ["min"]}, {"required": ["max"]}],
            "allOf": [
              {
                "if": {"required": ["confidence"]},
                "then": {
                  "required": ["seed_aggregation"],
                  "properties": {"seed_aggregation": {"const": "lcb"}}
                }
              }
            ],
            "properties": {
              "min": {"type": "number"},
              "max": {"type": "number"},
              "seed_aggregation": {"enum": ["mean", "worst", "lcb"]},
              "confidence": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1}
            }
          }
        }
          },
          "anyOf": [
            {
              "required": ["metric", "mode"],
              "not": {"anyOf": [{"required": ["metrics"]}, {"required": ["aggregation"]}]}
            },
            {
              "required": ["metrics"],
              "not": {"anyOf": [{"required": ["metric"]}, {"required": ["mode"]}]}
            }
          ]
        }
      ]
    },
    "searchDimension": {
      "oneOf": [
        {"type": "array", "minItems": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "values": {"type": "array", "minItems": 1},
            "range": {
              "type": "array",
              "prefixItems": [{"type": "number"}, {"type": "number"}],
              "minItems": 2,
              "maxItems": 2
            },
            "type": {"enum": ["uniform", "float", "loguniform", "int"]},
            "scale": {"enum": ["linear", "log"]},
            "when": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}
            }
          },
          "oneOf": [
            {"required": ["values"], "not": {"required": ["range"]}},
            {"required": ["range"], "not": {"required": ["values"]}}
          ]
        }
      ]
    },
    "search": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "strategy": {"enum": ["adaptive", "exhaustive"]},
        "goal": {"enum": ["optimize", "balanced", "understand"]},
        "stop": {
          "oneOf": [
            {"const": "auto"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["stability"],
              "properties": {
                "stability": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
              }
            }
          ]
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "candidates": {"type": "integer", "minimum": 1},
            "runs": {"type": "integer", "minimum": 1},
            "time": {
              "oneOf": [
                {"type": "number", "exclusiveMinimum": 0},
                {"type": "string", "pattern": "^\\s*[0-9]+(?:\\.[0-9]+)?\\s*[smhd]\\s*$"}
              ]
            }
          }
        },
        "space": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/searchDimension"}
        },
        "replication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum": {"type": "integer", "minimum": 1},
            "confirmation": {
              "oneOf": [
                {"const": "auto"},
                {"type": "array", "uniqueItems": true, "items": {"type": "integer"}}
              ]
            }
          }
        },
        "pruning": {
          "oneOf": [
            {"type": "boolean"},
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "min_step": {"type": "integer", "minimum": 1},
                "confirmations": {"type": "integer", "minimum": 1},
                "probability_threshold": {"type": "number", "minimum": 0, "maximum": 1},
                "equivalence_margin": {"type": "number", "minimum": 0}
              }
            }
          ]
        },
        "trials": {"type": "integer", "minimum": 1},
        "proposal_pool_size": {"type": "integer", "minimum": 1},
        "runs_per_gpu": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"const": "auto"}
          ]
        },
        "max_parallel": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"const": "auto"},
            {"type": "null"}
          ]
        },
        "min_seeds": {"type": "integer", "minimum": 1},
        "startup_trials": {"type": "integer", "minimum": 1},
        "failure_retries": {"type": "integer", "minimum": 0, "maximum": 3},
        "seed_probability_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "equivalence_margin": {"type": "number", "minimum": 0},
        "seed_racing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "probability_threshold": {"type": "number", "minimum": 0, "maximum": 1},
            "equivalence_margin": {"type": "number", "minimum": 0}
          }
        },
        "confirmation_top_k": {"type": "integer", "minimum": 1},
        "confirmation_seeds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer"}
        },
        "max_runs": {"type": "integer", "minimum": 1},
        "max_time": {
          "oneOf": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "string", "pattern": "^\\s*[0-9]+(?:\\.[0-9]+)?\\s*[smhd]\\s*$"}
          ]
        },
        "convergence_patience": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Optional number of full-fidelity non-record results before proposals stop; zero disables record-streak convergence and consumes the candidate budget."
        },
        "min_improvement": {"type": "number", "minimum": 0},
        "sampler": {"enum": ["auto", "knn", "botorch"]},
        "fidelity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {"type": "integer", "minimum": 1},
            "max": {"type": "integer", "minimum": 1},
            "reduction_factor": {"type": "integer", "minimum": 2}
          }
        },
        "early_stopping": {
          "oneOf": [
            {"type": "boolean"},
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "min_step": {"type": "integer", "minimum": 1},
                "confirmations": {"type": "integer", "minimum": 1},
                "probability_threshold": {"type": "number", "minimum": 0, "maximum": 1},
                "equivalence_margin": {"type": "number", "minimum": 0}
              }
            }
          ]
        }
      },
      "additionalProperties": {"$ref": "#/$defs/searchDimension"}
    },
    "sweepDimension": {
      "oneOf": [
        {"type": "array", "minItems": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "values": {"type": "array", "minItems": 1},
            "range": {
              "type": "array",
              "prefixItems": [{"type": "number"}, {"type": "number"}],
              "minItems": 2,
              "maxItems": 2
            },
            "points": {"type": "integer", "minimum": 2},
            "scale": {"enum": ["linear", "log"]},
            "when": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}
            }
          },
          "oneOf": [
            {"required": ["values"], "not": {"anyOf": [{"required": ["range"]}, {"required": ["points"]}]}},
            {"required": ["range", "points"], "not": {"required": ["values"]}}
          ]
        }
      ]
    },
    "sweep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space"],
      "properties": {
        "space": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sweepDimension"}
        },
        "reference": {"type": "object", "minProperties": 1}
        ,"replicates": {"type": "integer", "minimum": 1}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runs_per_gpu": {"oneOf": [{"type": "integer", "minimum": 1}, {"const": "auto"}]},
        "max_parallel": {"oneOf": [{"type": "integer", "minimum": 1}, {"const": "auto"}, {"type": "null"}]},
        "failure_retries": {"type": "integer", "minimum": 0, "maximum": 3},
        "max_runs": {"type": "integer", "minimum": 1},
        "max_time": {
          "oneOf": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "string", "pattern": "^\\s*[0-9]+(?:\\.[0-9]+)?\\s*[smhd]\\s*$"}
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {"type": "integer", "minimum": 1},
        "memory": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string"}]},
        "gpu": {"type": "integer", "minimum": 0},
        "gpu_memory": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string"}]},
        "time": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "string"}]},
        "storage": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string"}]},
        "processes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
